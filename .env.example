# Copy to .env.local for local dev (never commit .env.local).
# On Vercel: Project → Settings → Environment Variables.

# Password for the login page
APP_PASSWORD=change-me
# Random long string used to sign the login cookie (e.g. `openssl rand -hex 32`)
AUTH_SECRET=

# Supabase: Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Kakao Developers → My Application → App Keys → REST API Key
KAKAO_REST_API_KEY=
# National Library of Korea ISBN (서지정보) API key — https://www.nl.go.kr/NL/contents/N31101030700.do
NLK_API_KEY=
